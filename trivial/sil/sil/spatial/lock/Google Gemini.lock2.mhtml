n><span class=3D"base"><span class=3D"strut" style=3D"height: 1em; vertical=
-align: -0.25em;"></span><span class=3D"mopen">((</span><span class=3D"mord=
 text"><span class=3D"mord">Core&nbsp;Count</span></span><span class=3D"msp=
ace" style=3D"margin-right: 0.2222em;"></span><span class=3D"mbin">=C3=97</=
