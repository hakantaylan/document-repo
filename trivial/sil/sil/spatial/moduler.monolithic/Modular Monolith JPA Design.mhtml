package $BASE_PACKAGE.house;

import org.springframework.stereotype.Component;
import java.util.*;
import java.util.stream.Collectors;
import $BASE_PACKAGE.shared.*;

@Component
public class GraphLoader {

    private final FurnitureGateway furnitureGateway;

    public GraphLoader(FurnitureGateway furnitureGateway) {
        this.furnitureGateway =3D furnitureGateway;
    }

    public void load(List&lt;House&gt; houses) {

        Set&lt;UUID&gt; furnitureIds =3D houses.stream()
            .flatMap(h -&gt; h.getFurnitureLinks().stream())
            .map(HouseFurniture::getFurnitureId)
            .collect(Collectors.toSet());

        Map&lt;UUID, FurnitureView&gt; map =3D furnitureGateway.findByIds(f=
urnitureIds);

        for (House h : houses) {
            for (HouseFurniture hf : h.getFurnitureLinks()) {
                hf.setFurniture(map.get(hf.getFurnitureId()));
            }
        }
    }
}
EOF

