        """, nativeQuery =3D true)
    Optional&lt;Troop&gt; findFirstParentOfType(Long troopId, String target=
Type);

    @Query(value =3D """
        WITH RECURSIVE tree_path AS (
            SELECT *, CAST(name AS VARCHAR(1000)) as sort_path FROM troop=
=20
            WHERE commander_id IS NULL AND troop_country =3D :country AND d=
eleted =3D false
            UNION ALL
            SELECT t.*, CAST(tp.sort_path || ' &gt; ' || t.name AS VARCHAR(=
1000))
            FROM troop t INNER JOIN tree_path tp ON t.commander_id =3D tp.i=
d
            WHERE t.deleted =3D false
