            SELECT t.* FROM troop t INNER JOIN subordinates s ON t.commande=
r_id =3D s.id
            WHERE t.deleted =3D false
        )
        SELECT * FROM subordinates WHERE (:type IS NULL OR type =3D :type)
        """, nativeQuery =3D true)
    List&lt;Troop&gt; findDescendants(Long rootId, String type);

    @Query(value =3D """
        WITH RECURSIVE lineage AS (
            SELECT t.* FROM troop t WHERE t.id =3D (SELECT commander_id FRO=
M troop WHERE id =3D :childId) AND t.deleted =3D false
            UNION ALL
            SELECT t.* FROM troop t INNER JOIN lineage l ON t.id =3D l.comm=
ander_id
            WHERE t.deleted =3D false
        )
        SELECT * FROM lineage
        """, nativeQuery =3D true)
    List&lt;Troop&gt; findAllAncestors(Long childId);

    @Query(value =3D """
        WITH RECURSIVE lineage AS (
            SELECT t.* FROM troop t WHERE t.id =3D (SELECT commander_id FRO=
M troop WHERE id =3D :troopId) AND t.deleted =3D false
            UNION ALL
            SELECT t.* FROM troop t INNER JOIN lineage l ON t.id =3D l.comm=
ander_id
            WHERE t.deleted =3D false
        )
