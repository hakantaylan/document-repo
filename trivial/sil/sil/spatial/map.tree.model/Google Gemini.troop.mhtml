package com.example.logistics.controller;

import com.example.logistics.entity.*;
import com.example.logistics.service.TroopService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestController
@RequestMapping("/api/troops")
@RequiredArgsConstructor
public class TroopController {
    private final TroopService troopService;

    @GetMapping("/{id}/subordinates")
    public List&lt;Troop&gt; getSubs(@PathVariable Long id, @RequestParam(r=
equired =3D false) TroopType type) {
        return troopService.getSubordinates(id, type);
    }

    @GetMapping("/{id}/ancestors")
    public List&lt;Troop&gt; getAncestors(@PathVariable Long id) {
        return troopService.getAncestors(id);
    }

    @GetMapping("/{id}/nearest-parent")
    public Troop getNearest(@PathVariable Long id, @RequestParam TroopType =
type) {
        return troopService.getNearestParentOfType(id, type).orElse(null);
    }

    @GetMapping("/hierarchy")
    public List&lt;Troop&gt; getHierarchy(@RequestParam String country) {
        return troopService.getCountryHierarchy(country);
    }
}
