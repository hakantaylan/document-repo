package com.example.logistics.entity;

import jakarta.persistence.*;
import lombok.*;
import org.hibernate.annotations.SoftDelete;
import java.util.ArrayList;
import java.util.List;

@Entity
@SoftDelete
@Getter @Setter @NoArgsConstructor
public class Troop {
    @Id
    @GeneratedValue(strategy =3D GenerationType.SEQUENCE, generator =3D "tr=
oop_seq")
    @SequenceGenerator(name =3D "troop_seq", allocationSize =3D 50)
    private Long id;

    private String name;
    private String troopCountry;

    @Enumerated(EnumType.STRING)
    private TroopType type;

    @ManyToOne(fetch =3D FetchType.LAZY)
    @JoinColumn(name =3D "commander_id")
    private Troop commander;

    @OneToMany(mappedBy =3D "owner")
    private List&lt;FurnitureStock&gt; stocks =3D new ArrayList&lt;&gt;();
}
