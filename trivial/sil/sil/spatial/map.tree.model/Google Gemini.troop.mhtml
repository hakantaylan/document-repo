package com.example.logistics.service;

import com.example.logistics.entity.*;
import com.example.logistics.repository.*;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

@Service
@RequiredArgsConstructor
public class TroopService {
    private final TroopRepository troopRepo;

    public List&lt;Troop&gt; getSubordinates(Long id, TroopType type) {
        return troopRepo.findDescendants(id, type !=3D null ? type.name() :=
 null);
    }

    public List&lt;Troop&gt; getAncestors(Long id) {
        return troopRepo.findAllAncestors(id);
    }

    public Optional&lt;Troop&gt; getNearestParentOfType(Long id, TroopType =
type) {
        return troopRepo.findFirstParentOfType(id, type.name());
    }

    public List&lt;Troop&gt; getCountryHierarchy(String country) {
        return troopRepo.findAllByCountryOrdered(country);
    }
}
EOF</span>

