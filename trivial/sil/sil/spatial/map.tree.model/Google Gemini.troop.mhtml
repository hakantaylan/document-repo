package com.example.logistics.repository;

import com.example.logistics.entity.*;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import java.util.List;
import java.util.Optional;

public interface TroopRepository extends JpaRepository&lt;Troop, Long&gt; {

    // 1 &amp; 2. Find all sub-children (with optional type filtering)
    @Query(value =3D """
        WITH RECURSIVE subordinates AS (
            SELECT * FROM troop WHERE commander_id =3D :rootId AND deleted =
=3D false
            UNION ALL
            SELECT t.* FROM troop t INNER JOIN subordinates s ON t.commande=
r_id =3D s.id
            WHERE t.deleted =3D false
        )
        SELECT * FROM subordinates WHERE (:type IS NULL OR type =3D :type)
        """, nativeQuery =3D true)
    List&lt;Troop&gt; findDescendants(Long rootId, String type);

    // 3. Find all parents
    @Query(value =3D """
        WITH RECURSIVE lineage AS (
            SELECT t.* FROM troop t WHERE t.id =3D (SELECT commander_id FRO=
M troop WHERE id =3D :childId) AND t.deleted =3D false
            UNION ALL
            SELECT t.* FROM troop t INNER JOIN lineage l ON t.id =3D l.comm=
ander_id
            WHERE t.deleted =3D false
        )
        SELECT * FROM lineage
        """, nativeQuery =3D true)
    List&lt;Troop&gt; findAllAncestors(Long childId);

    // 4. DB-Level: First parent with specified type
    @Query(value =3D """
        WITH RECURSIVE lineage AS (
            SELECT t.* FROM troop t WHERE t.id =3D (SELECT commander_id FRO=
M troop WHERE id =3D :troopId) AND t.deleted =3D false
            UNION ALL
            SELECT t.* FROM troop t INNER JOIN lineage l ON t.id =3D l.comm=
ander_id
            WHERE t.deleted =3D false
        )
        SELECT * FROM lineage WHERE type =3D :targetType LIMIT 1
        """, nativeQuery =3D true)
    Optional&lt;Troop&gt; findFirstParentOfType(Long troopId, String target=
Type);

    // 5. Ordered list by country
    @Query(value =3D """
        WITH RECURSIVE tree_path AS (
            SELECT *, CAST(name AS VARCHAR(1000)) as sort_path FROM troop=
=20
            WHERE commander_id IS NULL AND troop_country =3D :country AND d=
eleted =3D false
            UNION ALL
            SELECT t.*, CAST(tp.sort_path || ' &gt; ' || t.name AS VARCHAR(=
1000))
            FROM troop t INNER JOIN tree_path tp ON t.commander_id =3D tp.i=
d
            WHERE t.deleted =3D false
        )
        SELECT * FROM tree_path ORDER BY sort_path
        """, nativeQuery =3D true)
    List&lt;Troop&gt; findAllByCountryOrdered(String country);
}
