    <span class=3D"hljs-comment">/**
     * Requirement 4: Finding first parent with specified type via Database
     * This climbs the tree (bottom-up) and returns the single nearest matc=
h.
     */</span>
    <span class=3D"hljs-meta">@Query(value =3D """
        WITH RECURSIVE lineage AS (
            -- Start with the immediate commander of the troop
            SELECT t.* FROM troop t=20
            WHERE t.id =3D (SELECT commander_id FROM troop WHERE id =3D :tr=
oopId)
              AND t.deleted =3D false
           =20
            UNION ALL
           =20
            -- Recursively move up to the next commander
            SELECT t.* FROM troop t
            INNER JOIN lineage l ON t.id =3D l.commander_id
            WHERE t.deleted =3D false
        )
        SELECT * FROM lineage=20
        WHERE type =3D :targetType=20
        LIMIT 1
        """, nativeQuery =3D true)</span>
    <span class=3D"hljs-function">Optional&lt;Troop&gt; <span class=3D"hljs=
-title">findFirstParentOfType</span><span class=3D"hljs-params">(Long troop=
