package com.example.logistics.service;

import com.example.logistics.entity.*;
import com.example.logistics.repository.*;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.util.List;
import java.util.Optional;

@Service
@RequiredArgsConstructor
public class LogisticsService {
    private final FurnitureStockRepository stockRepo;
    private final TroopRepository troopRepo;

    @Transactional
    public void transferFurniture(Long stockId, Long toTroopId, int quantit=
y) {
        FurnitureStock source =3D stockRepo.findById(stockId).orElseThrow()=
;
        Troop target =3D troopRepo.findById(toTroopId).orElseThrow();

        if (!source.getOwner().getTroopCountry().equals(target.getTroopCoun=
try())) {
            throw new RuntimeException("Transfers only allowed within same =
country.");
        }
        if (source.getAmount() &lt; quantity) throw new RuntimeException("I=
nsufficient stock.");

        Troop origin =3D (source.getOriginalOwner() !=3D null) ? source.get=
OriginalOwner() : source.getOwner();
        source.setAmount(source.getAmount() - quantity);
        if (source.getAmount() =3D=3D 0) stockRepo.delete(source);

        FurnitureStock targetStock =3D stockRepo.findByOwnerAndModelAndOrig=
inalOwner(target, source.getModel(), origin)
            .orElseGet(() -&gt; {
                FurnitureStock ns =3D new FurnitureStock();
                ns.setModel(source.getModel());
                ns.setOwner(target);
                ns.setOriginalOwner(origin);
                ns.setAmount(0);
                return ns;
            });

        targetStock.setAmount(targetStock.getAmount() + quantity);
        stockRepo.save(targetStock);
    }

    @Transactional
    public void takeBack(Long stockId) {
        FurnitureStock stock =3D stockRepo.findById(stockId).orElseThrow();
        if (stock.getOriginalOwner() =3D=3D null) throw new RuntimeExceptio=
n("Item is at origin.");
        transferFurniture(stockId, stock.getOriginalOwner().getId(), stock.=
getAmount());
    }

    public List&lt;Troop&gt; getSubordinates(Long id, TroopType type) {
        return troopRepo.findDescendants(id, type !=3D null ? type.name() :=
 null);
    }

    public Optional&lt;Troop&gt; getNearestHQ(Long id, TroopType type) {
        return troopRepo.findFirstParentOfType(id, type.name());
    }
}
