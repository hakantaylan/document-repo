<li data-start=3D"2088" data-end=3D"2132">
<p data-start=3D"2090" data-end=3D"2132">Hibernate L2 =E2=86=92 for entity =
identity caching</p>
</li>
<li data-start=3D"2133" data-end=3D"2187">
<p data-start=3D"2135" data-end=3D"2187">Spring <code data-start=3D"2142" d=
ata-end=3D"2154">@Cacheable</code> =E2=86=92 for DTOs or aggregated results=
</p>
</li>
</ul>
