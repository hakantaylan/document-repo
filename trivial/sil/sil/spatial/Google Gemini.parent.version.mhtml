e
            FROM DangerZone dz
            WHERE dz.parent_version_id =3D pv.id
              AND ST_DWithin(dz.shape::geography, d.point::geography, 500)
            ORDER BY d.point &lt;-&gt; dz.shape -- Nearest Neighbor Index S=
earch
            LIMIT 1
        ) AS dz_stats ON TRUE
        WHERE p.PARENT_NO =3D :parentNo
        """, nativeQuery =3D true)</span>
