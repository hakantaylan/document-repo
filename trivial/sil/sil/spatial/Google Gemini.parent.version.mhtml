52903312-165"><span class=3D"hljs-meta">@Repository</span>
<span class=3D"hljs-keyword">public</span> <span class=3D"hljs-class"><span=
 class=3D"hljs-keyword">interface</span> <span class=3D"hljs-title">Destina=
tionRepository</span> <span class=3D"hljs-keyword">extends</span> <span cla=
ss=3D"hljs-title">JpaRepository</span>&lt;<span class=3D"hljs-title">Destin=
ation</span>, <span class=3D"hljs-title">Long</span>&gt; </span>{

    <span class=3D"hljs-meta">@Query(value =3D """
        SELECT=20
            d.id, d.name, d.no, d.point,
            dz_stats.dist AS dangerZoneDistance,
            dz_stats.name AS dangerZoneName,
            dz_stats.angle AS dangerZoneAngle
        FROM Destination d
        JOIN Location l ON d.location_id =3D l.id
        JOIN ParentVersion pv ON l.parent_version_id =3D pv.id
        -- Determine if we are looking at Draft or Last version
        JOIN Parent p ON (
            (:isDraft =3D true AND p.draft_version_id =3D pv.id) OR=20
            (:isDraft =3D false AND p.last_version_id =3D pv.id)
        )
        -- The Spatial Calculation moved to DB level
        LEFT JOIN LATERAL (
            SELECT=20
                dz.name,
                ST_Distance(dz.shape::geography, d.point::geography) AS dis=
t,
                DEGREES(ST_Azimuth(d.point, ST_Centroid(dz.shape))) AS angl=
e
            FROM DangerZone dz
            WHERE dz.parent_version_id =3D pv.id  -- Optional: only zones i=
n same version
              AND ST_DWithin(dz.shape::geography, d.point::geography, 500)
            ORDER BY d.point &lt;-&gt; dz.shape -- Index-assisted distance =
sorting
            LIMIT 1
        ) AS dz_stats ON TRUE
        WHERE p.PARENT_NO =3D :parentNo
        """, nativeQuery =3D true)</span>
    List&lt;Object[]&gt; findDestinationsWithSpatialData(String parentNo, <=
span class=3D"hljs-keyword">boolean</span> isDraft);
}
