    <span class=3D"hljs-meta">@Query(value =3D """
        SELECT=20
            d.id AS id,=20
            d.name AS name,=20
            d.no AS no,
            dz_stats.dist AS dangerZoneDistance,
            dz_stats.name AS dangerZoneName,
            dz_stats.angle AS dangerZoneAngle
        FROM Destination d
        JOIN Location l ON d.location_id =3D l.id
        JOIN ParentVersion pv ON l.parent_version_id =3D pv.id
        -- Dynamic version switching
        JOIN Parent p ON (
            (:isDraft =3D true AND p.draft_version_id =3D pv.id) OR=20
            (:isDraft =3D false AND p.last_version_id =3D pv.id)
        )
        -- Spatial "Closer than 500" Calculation
        LEFT JOIN LATERAL (
            SELECT=20
                dz.name,
