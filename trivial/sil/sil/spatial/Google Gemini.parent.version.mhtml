<span class=3D"hljs-keyword">public</span> <span class=3D"hljs-class"><span=
 class=3D"hljs-keyword">interface</span> <span class=3D"hljs-title">Destina=
tionRepository</span> <span class=3D"hljs-keyword">extends</span> <span cla=
ss=3D"hljs-title">JpaRepository</span>&lt;<span class=3D"hljs-title">Destin=
ation</span>, <span class=3D"hljs-title">Long</span>&gt; </span>{

    <span class=3D"hljs-comment">// Step 1: Fetch Hierarchy with Parent det=
ails</span>
    <span class=3D"hljs-meta">@Query("""
        SELECT d, p FROM Destination d=20
        JOIN d.location l=20
        JOIN l.parentVersion pv=20
        JOIN Parent p ON (
            (:isDraft =3D true AND p.draftVersion =3D pv) OR=20
            (:isDraft =3D false AND p.lastVersion =3D pv)
        )
        WHERE p.parentNo =3D :parentNo
    """)</span>
    List&lt;Object[]&gt; findHierarchyWithParent(<span class=3D"hljs-meta">=
@Param("parentNo")</span> String parentNo, <span class=3D"hljs-meta">@Param=
("isDraft")</span> <span class=3D"hljs-keyword">boolean</span> isDraft);

    <span class=3D"hljs-comment">// Step 2: Batch Spatial Calculation (Rema=
ins the same as previous)</span>
    <span class=3D"hljs-meta">@Query(value =3D """
        SELECT=20
            d.id as id,
            dz.name as name,
            ST_Distance(dz.shape::geography, d.point::geography) as dist,
            DEGREES(ST_Azimuth(d.point, ST_Centroid(dz.shape))) as angle
        FROM Destination d
        LEFT JOIN LATERAL (
            SELECT name, shape FROM DangerZone=20
            WHERE ST_DWithin(shape::geography, d.point::geography, 500)
              AND ST_Distance(shape::geography, d.point::geography) &lt;=3D=
 500
            ORDER BY shape &lt;-&gt; d.point=20
            LIMIT 1
        ) dz ON TRUE
        WHERE d.id IN :ids
    """, nativeQuery =3D true)</span>
    List&lt;Object[]&gt; fetchSpatialMetrics(<span class=3D"hljs-meta">@Par=
am("ids")</span> List&lt;Long&gt; ids);
}
